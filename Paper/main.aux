\newlabel{sec:eval-proving}{{6.3}{11}{Proving Time}{subsection.6.3}{}}
\citation{kate2010constant}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Performance comparison of $\textsf  {FastMatMul}$ variants and the Freivalds baseline. All three $\textsf  {FastMatMul}$ variants exhibit $\mathcal  {O}(k)$ checking-layer constraint growth under the conditional linear-time code-commitment backend model, versus $\mathcal  {O}(k^2)$ for Freivalds. $\textsf  {FastMatMul}_{\mathsf  {Merkle}}$ uses a transparent SNARK backend with Merkle-tree commitments implemented with Pedersen hashes; $\textsf  {FastMatMul}_{\mathsf  {KZG}}$ uses a pairing-based (Groth16) backend with KZG commitments; $\textsf  {FastMatMul}_{\mathsf  {CPLink}}$ uses a Groth16 circuit backend with Merkle-tree commitments and CP-SNARK linking. The table does not isolate or independently measure a standalone $\textsf  {CodeCom.Verify}$ component. Freivalds uses an optimized implementation. ``---'' indicates the experiment did not complete in the benchmark environment because it exhausted available memory; peak memory was not logged by the current artifact. Proof sizes for $\textsf  {FastMatMul}$ variants range from $1.70$--$48.79$\,MB (see Section\nonbreakingspace \ref {sec:eval-verify}).}}{12}{table.caption.62}\protected@file@percent }
\newlabel{tab:meow-vs-freivalds}{{4}{12}{Performance comparison of $\protocol $ variants and the Freivalds baseline. All three $\protocol $ variants exhibit $\mathcal {O}(k)$ checking-layer constraint growth under the conditional linear-time code-commitment backend model, versus $\mathcal {O}(k^2)$ for Freivalds. $\fmMerkle $ uses a transparent SNARK backend with Merkle-tree commitments implemented with Pedersen hashes; $\fmKZG $ uses a pairing-based (Groth16) backend with KZG commitments; $\fmCPLink $ uses a Groth16 circuit backend with Merkle-tree commitments and CP-SNARK linking. The table does not isolate or independently measure a standalone $\codeComV $ component. Freivalds uses an optimized implementation. ``---'' indicates the experiment did not complete in the benchmark environment because it exhausted available memory; peak memory was not logged by the current artifact. Proof sizes for $\protocol $ variants range from $1.70$--$48.79$\,MB (see Section~\ref {sec:eval-verify})}{table.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Proving time comparison on a log scale. $\textsf  {FastMatMul}_{\mathsf  {Merkle}}$ becomes faster than Freivalds at $\log k = 8$; $\textsf  {FastMatMul}_{\mathsf  {KZG}}$ and $\textsf  {FastMatMul}_{\mathsf  {CPLink}}$ cross over between $\log k = 9$ and $\log k = 10$. At $\log k = 11$, the speedup reaches $2.06\times $--$2.95\times $. Freivalds does not complete at $\log k = 12$ in the benchmark environment.}}{12}{figure.caption.63}\protected@file@percent }
\newlabel{fig:provetime}{{3}{12}{Proving time comparison on a log scale. $\fmMerkle $ becomes faster than Freivalds at $\log k = 8$; $\fmKZG $ and $\fmCPLink $ cross over between $\log k = 9$ and $\log k = 10$. At $\log k = 11$, the speedup reaches $2.06\times $--$2.95\times $. Freivalds does not complete at $\log k = 12$ in the benchmark environment}{figure.caption.63}{}}
