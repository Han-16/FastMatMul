\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Constraint count comparison on a log scale. All three $\textsf  {FastMatMul}$ variants exhibit $\mathcal  {O}(k)$ checking-layer growth under the conditional linear-time code-commitment backend model (slope $\approx 1$), while Freivalds exhibits $\mathcal  {O}(k^2)$ (slope $\approx 2$). Freivalds does not complete at $\log k = 12$ in the benchmark environment.}}{11}{figure.caption.61}\protected@file@percent }
\newlabel{fig:constraints}{{2}{11}{Constraint count comparison on a log scale. All three $\protocol $ variants exhibit $\mathcal {O}(k)$ checking-layer growth under the conditional linear-time code-commitment backend model (slope $\approx 1$), while Freivalds exhibits $\mathcal {O}(k^2)$ (slope $\approx 2$). Freivalds does not complete at $\log k = 12$ in the benchmark environment}{figure.caption.61}{}}
